# Binary media & documentation files
media/
*.docx
*.pdf

# Secrets and credentials
SECRET_MUST_READ.md
SECRET*.md
secrets/
.env
.env.*
*.key
*.pem
*.crt
*.cert
*.csr

# Data, captures and telemetry databases
data/
data/*.csv
data/*.jsonl
csi-prototype/data/
csi-prototype/data/*.jsonl
csi-prototype/data/*.csv
**/data/recordings
**/data/recordings/**
**/*.db
**/*.db-*
**/*.db-wal
**/*.db-shm

# ESP-IDF managed components & lock files
**/managed_components/
**/dependencies.lock

# Python bytecode and environments
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/.pytest_cache/

# Runtime evidence / process logs
evidence/*.pid
evidence/*.log
**/evidence/*.pid
**/evidence/*.log

# Firmware build directories và config backups
**/build/
**/.espidf/
**/sdkconfig.old

# OS / Editor temporary files
.DS_Store
*.swp
*.swo
